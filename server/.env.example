# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://chronix:chronix_dev@localhost:5433/chronix_dev
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── API Server ───────────────────────────────────────────────────────────────
API_PORT=3000
CORS_ORIGIN=http://localhost:3001

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Run `pnpm setup:local` to generate a valid ES256 key pair and local secrets.
# Never reuse generated development secrets in production.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
# Minimum 32-char random string — used as HMAC pepper for API key hashing
API_KEY_HMAC_SECRET=replace-me-with-at-least-32-random-chars-here
APP_ENCRYPTION_KEY=replace-me-with-a-32-byte-random-key

# ─── Security ─────────────────────────────────────────────────────────────────
ARGON2_MEMORY_COST=65536

# ─── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_TICK_MS=5000
SCHEDULER_BATCH_SIZE=50
LEASE_DURATION_MS=60000

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=10
# WORKER_ROLE: "executor" (default) or "scheduler"
WORKER_ROLE=executor
# Free-tier demo only: run scheduler and executor inside the API process.
EMBEDDED_WORKERS=false

# ─── Observability (optional) ─────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
