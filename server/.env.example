# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://chronix:chronix_dev@localhost:5432/chronix_dev
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API Server ───────────────────────────────────────────────────────────────
API_PORT=3000
CORS_ORIGIN=http://localhost:3001

# ─── JWT (generate with: node -e "require('crypto').generateKeyPairSync('ec',{namedCurve:'P-256',...})")
# Use ES256 key pair. Replace with real keys in production.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
# Minimum 32-char random string — used as HMAC pepper for API key hashing
API_KEY_HMAC_SECRET=replace-me-with-at-least-32-random-chars-here

# ─── Security ─────────────────────────────────────────────────────────────────
ARGON2_MEMORY_COST=65536

# ─── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_TICK_MS=5000
SCHEDULER_BATCH_SIZE=50
LEASE_DURATION_MS=60000

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=10
# WORKER_ROLE: "executor" (default) or "scheduler"
WORKER_ROLE=executor

# ─── Observability (optional) ─────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
