{
	"name": "@chronix/server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.19.0 <25",
		"pnpm": "11.21.0"
	},
	"packageManager": "pnpm@11.21.0",
	"scripts": {
		"setup:local": "node scripts/setup-local.mjs",
		"dev": "tsx watch --exclude 'src/generated/**' src/app.ts",
		"dev:worker": "tsx watch --exclude 'src/generated/**' src/worker.ts",
		"dev:scheduler": "WORKER_ROLE=scheduler tsx watch --exclude 'src/generated/**' src/worker.ts",
		"build": "prisma generate && tsup src/app.ts src/worker.ts --format esm --dts --sourcemap --clean",
		"typecheck": "prisma generate && tsc --noEmit && tsc --project tsconfig.scripts.json --noEmit",
		"lint": "prisma generate && eslint src lib prisma/seed.ts scripts/verify-prisma.ts --max-warnings=0",
		"prisma:generate": "prisma generate",
		"prisma:seed": "prisma db seed",
		"prisma:verify": "tsx scripts/verify-prisma.ts",
		"migrate": "prisma migrate dev",
		"migrate:deploy": "prisma migrate deploy",
		"test:unit": "prisma generate && vitest run --project unit",
		"test:integration": "prisma generate && vitest run --project integration",
		"test": "prisma generate && vitest run"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "9.1.0",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/auto-instrumentations-node": "0.79.0",
		"@opentelemetry/exporter-trace-otlp-grpc": "0.221.0",
		"@opentelemetry/sdk-node": "0.221.0",
		"@prisma/adapter-pg": "7.9.1",
		"@prisma/client": "7.9.1",
		"argon2": "0.45.1",
		"bullmq": "5.81.3",
		"cookie-parser": "1.4.7",
		"cors": "2.8.6",
		"cron-parser": "5.7.0",
		"dotenv": "17.4.2",
		"express": "5.2.1",
		"helmet": "8.3.0",
		"ioredis": "5.11.1",
		"jose": "6.2.5",
		"luxon": "3.7.2",
		"pg": "8.22.0",
		"pino": "10.3.1",
		"pino-http": "11.0.0",
		"prom-client": "15.1.3",
		"undici": "8.9.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@testcontainers/postgresql": "12.0.4",
		"@types/cookie-parser": "1.4.10",
		"@types/cors": "2.8.19",
		"@types/express": "5.0.6",
		"@types/luxon": "3.7.2",
		"@types/node": "24.10.10",
		"@types/pg": "8.20.0",
		"@types/supertest": "7.2.1",
		"eslint": "9.39.5",
		"pino-pretty": "13.1.3",
		"prisma": "7.9.1",
		"supertest": "7.2.2",
		"testcontainers": "12.0.4",
		"tsup": "8.5.1",
		"tsx": "4.23.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.65.0",
		"vitest": "4.1.10"
	}
}
